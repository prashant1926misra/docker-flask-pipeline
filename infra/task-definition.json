{
  "family": "myapp-task",
  "networkMode": "awsvpc", 
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::703623468959:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "myapp-container",
      "image": "703623468959.dkr.ecr.ap-south-1.amazonaws.com/ecr-repo:c74f470a06d676ecbd12b04190bb4d91f9e8b025",
      "essential": true,
      "cpu": 0,
      "environment": [],
      "environmentFiles": [],
      "mountPoints": [],
      "systemControls": [],
      "ulimits": [],
      "volumesFrom": [],
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/myapp-task", 
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      }
    }
  ],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "taskDefinitionArn": "arn:aws:ecs:ap-south-1:703623468959:task-definition/myapp-task:2"
}
